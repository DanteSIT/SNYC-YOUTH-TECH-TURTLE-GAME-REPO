shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// Seabed sand.
//
// Both maps are generated by tools/make_sand_textures.py from one shared periodic
// height field, so they are seamless in every direction and the lighting in the
// normal map agrees with the shading in the albedo.
//
// The bed is instanced at wildly different scales across the levels, so it is
// shaded triplanar from world position rather than from mesh UVs. That also means
// the tiling frequency has to be specified in METRES, not in texture repeats --
// the old shader multiplied world position by `tile = 4.0`, i.e. one repeat every
// 25 cm, which is 4096 texels per metre and turns into pure aliasing shimmer as
// soon as the bed is more than a couple of metres away.

uniform sampler2D albedo_tex : source_color, repeat_enable, filter_linear_mipmap_anisotropic;
uniform sampler2D normal_tex : hint_normal, repeat_enable, filter_linear_mipmap_anisotropic;

// How many metres one repeat of the texture covers. Bigger = coarser sand.
uniform float tile_size : hint_range(0.25, 16.0, 0.05) = 2.5;

uniform vec3 tint : source_color = vec3(1.0, 0.97, 0.92);

// A second, much finer grain that only fades in near the camera. Sand that reads
// well at arm's length and does not boil at the far end of the corridor.
uniform float detail_strength : hint_range(0.0, 1.0) = 0.45;
uniform float detail_scale : hint_range(1.0, 24.0) = 7.0;
uniform float detail_range : hint_range(1.0, 40.0) = 14.0;

uniform float normal_strength : hint_range(0.0, 3.0) = 1.15;
uniform float wetness : hint_range(0.0, 1.0) = 0.0;

varying vec3 world_pos;
varying float view_dist;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	view_dist = length((MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz);
}

// Signed weights: each face only gets the projection that faces the camera, so a
// chamfer or a wall does not pick up a smeared copy of the floor's UVs.
vec3 triplanar_weights(vec3 n) {
	vec3 w = abs(normalize(n));
	return w / max(w.x + w.y + w.z, 0.0001);
}

vec3 triplanar_albedo(vec2 uv_x, vec2 uv_y, vec2 uv_z, vec3 w) {
	return texture(albedo_tex, uv_x).rgb * w.x
		 + texture(albedo_tex, uv_y).rgb * w.y
		 + texture(albedo_tex, uv_z).rgb * w.z;
}

void fragment() {
	// Godot feeds NORMAL in view space here; the blend weights only need the
	// dominant axis, which is the same in any space, but the swizzles below
	// assume world space -- so recompute from the world normal varying.
	vec3 n_view = normalize(NORMAL);
	vec3 n_world = normalize((VIEW_MATRIX * vec4(n_view, 0.0)).xyz);
	vec3 w = triplanar_weights(n_world);

	float inv = 1.0 / max(tile_size, 0.05);
	vec2 uv_x = world_pos.zy * inv;
	vec2 uv_y = world_pos.xz * inv;
	vec2 uv_z = world_pos.xy * inv;

	// Close-up grain, faded out with distance so the far bed stays smooth.
	float near = 1.0 - clamp(view_dist / detail_range, 0.0, 1.0);
	vec3 col = triplanar_albedo(uv_x, uv_y, uv_z, w);
	if (near > 0.001 && detail_strength > 0.001) {
		float dinv = inv * detail_scale;
		vec3 fine = texture(albedo_tex, world_pos.zy * dinv).rgb * w.x
				  + texture(albedo_tex, world_pos.xz * dinv).rgb * w.y
				  + texture(albedo_tex, world_pos.xy * dinv).rgb * w.z;
		// Overlay rather than lerp: keeps the mean brightness of the base map.
		col = mix(col, col * (fine * 2.0), detail_strength * near);
	}

	ALBEDO = clamp(col * tint, vec3(0.0), vec3(1.0));

	// Triplanar normal blend, with each projection's tangent frame rotated into
	// world space before it is mixed.
	vec3 nx = texture(normal_tex, uv_x).rgb * 2.0 - 1.0;
	vec3 ny = texture(normal_tex, uv_y).rgb * 2.0 - 1.0;
	vec3 nz = texture(normal_tex, uv_z).rgb * 2.0 - 1.0;
	nx.z *= -1.0;
	nz.z *= -1.0;
	vec3 n_world_mapped = normalize(
		nx.zyx * w.x +
		ny.xzy * w.y +
		nz.xyz * w.z
	);
	// Perturb around the geometric normal rather than replacing it.
	NORMAL_MAP = n_world_mapped;
	NORMAL_MAP_DEPTH = normal_strength * mix(0.35, 1.0, near);

	// Wet sand in the low, silty parts of the bed reads slightly darker and
	// glossier than the dry crest.
	float wet = wetness * (1.0 - near * 0.4);
	ALBEDO *= 1.0 - wet * 0.22;
	ROUGHNESS = mix(0.95, 0.42, wet);
	SPECULAR = mix(0.35, 0.85, wet);
	METALLIC = 0.0;
}
