# Godot 4+ specific ignores
.godot/
/android/

# Build output (regenerate with the Export manager; never commit artifacts)
Export/

# Python tooling
__pycache__/
*.pyc

# Local-only rollback bookkeeping (snapshots + status log, not part of the game)
.gitinfo/

# Blender scratch autosaves
*.blend1
# Screenshots are deliverables written into the game directory, not source. They
# are also imported by Godot on sight, which would add a .import sidecar for each.
screenshots/

# Vendored ziva agent addon (huge binaries, no longer used)
addons/ziva_agent/
